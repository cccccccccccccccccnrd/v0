[Unit]
Description=yt0 bridge-only frontend socket
# No Docker ordering: socket units start before basic.target and Docker starts after it,
# so After/Requires=docker.service formed an ordering cycle at boot (2026-11-14) and systemd
# dropped Docker's start job. FreeBind lets this bind before Docker creates the gateway.

[Socket]
# Existing x_default Docker gateway; never bind this forwarder to a public interface.
ListenStream=172.22.0.1:3668
FreeBind=yes
NoDelay=yes

[Install]
WantedBy=sockets.target
