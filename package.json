{
  "name": "yt0-v2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env main.ts",
    "seed": "node --env-file-if-exists=.env cli.ts seed",
